# Pinterest Trends API / OAuth
PINTEREST_ACCESS_TOKEN=
# Or configure the OAuth file at .pinterest_oauth_tokens.json.

# Gemini is required for AI artwork and lifestyle-background generation.
GEMINI_API_KEY=
GEMINI_BACKEND=api-key
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# Optional: persistent browser profile used by the Pinterest image crawler.
# Defaults to trend_product_tool_standalone/pinterest/.pinterest_browser_profile.
# PINTEREST_BROWSER_PROFILE_DIR=

# HTTP server (localhost by default). Set host to 0.0.0.0 for trusted LAN access.
TREND_PRODUCT_API_HOST=127.0.0.1
TREND_PRODUCT_API_PORT=8000
